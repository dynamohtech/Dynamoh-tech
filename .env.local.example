# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project → Settings →
# Environment Variables, then redeploy (variables added after a deploy
# only take effect on the next deploy).

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Optional. Where form submissions are delivered.
# Default: dynamohtech24@gmail.com
#
# While you send from onboarding@resend.dev (the default sender), Resend
# only delivers to the email address that owns your Resend account. If
# your Resend account uses a different email, either put that email here
# or verify a domain and set CONTACT_FROM_EMAIL below.
# CONTACT_TO_EMAIL=you@example.com

# Optional. The "from" address. Must be on a domain verified in Resend.
# Default: Portfolio site <onboarding@resend.dev>
# CONTACT_FROM_EMAIL=Portfolio site <hello@yourdomain.com>
